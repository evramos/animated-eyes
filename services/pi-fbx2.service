[Unit]
Description=SPI framebuffer copy (fbx2)
StartLimitBurst=15
StartLimitIntervalSec=60
After=sysinit.target

[Service]
Type=simple
Environment=DISPLAY=:0
EnvironmentFile=/etc/pi-eyes/fbx2.env
ExecStart=/bin/sh -c 'exec /opt/Pi_Eyes/fbx2 $FBX2_MODE'
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target